# ---------------------------------------------------------------------------
# Sanscan deployment configuration
#
# Fill in your SAN devnet endpoint below (public devnet URL or local node).
# Local development overrides live in .env.local (git-ignored).
# ---------------------------------------------------------------------------

# SAN node REST endpoint that sanscan reads from and writes to.
# Local node:     http://127.0.0.1:8000
# Public devnet:  https://rpc.your-devnet.example.com   <-- put yours here
SAN_RPC_URL=http://127.0.0.1:8000

# Bearer token, only when the node runs with SAN_API_TOKEN.
# Keep secrets in .env.local instead of committing them here.
SAN_API_TOKEN=

# Index storage and polling.
SANSCAN_DATA_DIR=./data
SANSCAN_POLL_MS=4000
SANSCAN_SYNC_PAGE=256

# Public URL of this explorer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trust X-Forwarded-For for faucet IP limits (enable behind your reverse proxy).
SANSCAN_TRUST_PROXY=0
