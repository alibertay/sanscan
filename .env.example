# ---------------------------------------------------------------------------
# SANSCAN environment
# Copy to .env (or .env.local) and fill in your network values.
# ---------------------------------------------------------------------------

# SAN node REST endpoint that sanscan reads from and writes to.
# Local node:        http://127.0.0.1:8000
# Public devnet:     https://rpc.your-devnet.example.com
SAN_RPC_URL=http://127.0.0.1:8000

# Optional bearer token when the node runs with SAN_API_TOKEN.
SAN_API_TOKEN=

# Where the explorer index is persisted (NDJSON files).
SANSCAN_DATA_DIR=./data

# How often the indexer polls the node for new blocks (milliseconds).
SANSCAN_POLL_MS=4000

# Blocks fetched per sync page (1-1024).
SANSCAN_SYNC_PAGE=256

# Public URL of this explorer (used in metadata and API docs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to trust the X-Forwarded-For header when forwarding faucet
# requests (only enable behind a reverse proxy you control).
SANSCAN_TRUST_PROXY=0
